+        try:
+            options = json.loads(config.read_text(encoding="utf-8-sig"))
+            runner = (Path(options["checkout"]) / "tools" / "alien_memory.py").resolve()
+            if runner.is_relative_to(self.workspace) or not runner.is_file():
+                return
+            subprocess.run(
+                [sys.executable, "-I", str(runner), "--central", str(self.central.parent), "atualizar"],
+                stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
+                check=True, timeout=30,
+            )
+        except (KeyError, TypeError, ValueError, OSError, subprocess.SubprocessError) as exc:
+            self.log_event(None, "memory_refresh_failed", {"type": type(exc).__name__})
